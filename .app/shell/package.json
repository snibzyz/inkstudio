{
  "name": "@inkstudio/desktop-shell",
  "version": "0.1.0",
  "private": true,
  "description": "INKSTUDIO desktop shell — Electron + React renderer",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5573 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package:win": "pnpm build && electron-builder --win nsis portable",
    "publish:win": "pnpm build && electron-builder --win nsis portable --publish always",
    "package:mac": "pnpm build && electron-builder --mac dmg",
    "publish:mac": "pnpm build && electron-builder --mac dmg --publish always"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "electron-updater": "^6.3.9",
    "fabric": "^7.2.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.2.5",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.inkstudio.app",
    "productName": "INKSTUDIO",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/__tests__/**",
      "package.json",
      "public/**/*",
      "node_modules/ffmpeg-static/ffmpeg*",
      "node_modules/ffmpeg-static/index.js",
      "node_modules/ffmpeg-static/package.json",
      "!**/node_modules/canvas/**",
      "!**/node_modules/jsdom/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "snibzyz",
        "repo": "inkstudio"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "INKSTUDIO",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "artifactName": "INKSTUDIO-Setup-${version}.${ext}",
      "include": null
    },
    "portable": {
      "artifactName": "INKSTUDIO-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "public/logo.png",
      "identity": null,
      "artifactName": "INKSTUDIO-${version}-${arch}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": true
    }
  }
}
